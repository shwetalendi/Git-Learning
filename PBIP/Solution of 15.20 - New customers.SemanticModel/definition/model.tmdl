model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: it-IT
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Customer","Date","Product","Product Category","Product Subcategory","Sales"]

annotation __TEdtr = 1

annotation PBI_ProTooling = ["TMDLView_Desktop","DevMode"]

ref table Customer
ref table Date
ref table Product
ref table Sales
ref table Test

ref role 'United States'
ref role 'Full Access'
ref role 'Restricted Access'

ref perspective Presp

ref cultureInfo en-US

